# Copy to .env before `docker compose up --build`. Never commit the real .env.
#   cp .env.example .env

# --- Django core -------------------------------------------------------------
# Signing key for sessions and tokens. Generate a real one for any deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-change-me-in-production
# True enables the debug page and permissive checks. Never True in production.
DEBUG=True
# Comma-separated hostnames Django will answer for. "api" is the compose service name.
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Comma-separated origins the browser may call the API from (the Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Timezone used for SLA due timestamps.
TIME_ZONE=Asia/Riyadh

# --- Database ---------------------------------------------------------------
# Credentials the postgres container is created with.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
# Host port the database is published on. Defaults to 5433, not 5432, so it does
# not collide with a PostgreSQL already running on the machine. Change it only if
# 5433 is also taken. The api container is unaffected either way.
POSTGRES_PORT=5433
# How the api reaches the database. Compose sets this itself from the three
# values above; set it here only when running the backend outside Docker.
# Leave it UNSET to fall back to SQLite at backend/db.sqlite3.
# DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# --- Auth --------------------------------------------------------------------
# JWT lifetimes. Access tokens are short so a leaked one expires quickly; the
# refresh token is what keeps a session alive across the working day.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- AI ---------------------------------------------------------------------
# "mock" (default) or "claude". The mock backend is a real implementation of the
# same interface, deterministic per ticket and bilingual — no API key needed.
# Setting "claude" without ANTHROPIC_API_KEY makes Django refuse to start.
AI_BACKEND=mock
# ANTHROPIC_API_KEY=

# --- Frontend ---------------------------------------------------------------
# Baked into the Vite bundle at build time; must be reachable from the browser.
VITE_API_URL=http://localhost:8000/api/v1
